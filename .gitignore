# Unreal Engine generated folders — regenerated locally
Binaries/
Intermediate/
DerivedDataCache/
Saved/

# Plugin-level generated folders (in case you add plugins later)
Plugins/*/Binaries/
Plugins/*/Intermediate/

# Editor backups
Backup/

# IDE / Visual Studio — regenerated by "Generate Visual Studio project files"
.vs/
.vsconfig
*.sln
*.suo
*.user
*.opensdf
*.sdf
*.VC.db
*.VC.opendb
*.xcodeproj
*.xcworkspace

# Compiled binaries (covered above, but belt-and-suspenders)
*.pdb
*.dll
*.exe
*.lib
*.so
*.dylib

# Misc
*.log
*.tlog
UpgradeLog.htm
